# Copy to .env and fill in real values. Never commit .env.

# --- Application ---------------------------------------------------------
# development | testing | production
APP_ENV=development

# Long random string. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

LOG_LEVEL=INFO

# Set true if antivirus HTTPS inspection causes Python certificate failures.
USE_SYSTEM_CERTS=false

# Optional legacy Docker/Hugging Face setting.
HF_HUB_OFFLINE=0

# --- First admin account -------------------------------------------------
# Used by `flask seed` only when no administrator exists.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
ADMIN_FULL_NAME=System Administrator

# --- PostgreSQL + pgvector -----------------------------------------------
# Recommended: managed PostgreSQL such as Neon.
# SQLAlchemy uses psycopg v3, so keep `postgresql+psycopg://`.
# Example only; replace every placeholder.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Legacy Docker/local Postgres settings (optional).
POSTGRES_USER=nlprs
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nlprs
POSTGRES_HOST_PORT=5432

# Optional explicit test database. Its database name must end in `_test`.
# TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE_test?sslmode=require

# --- Redis ---------------------------------------------------------------
# Recommended: managed Redis such as Upstash TCP.
# Use TLS (`rediss://`) for cloud Redis.
REDIS_URL=rediss://default:TOKEN@HOST:6379

# Legacy Docker/local Redis port (optional).
REDIS_HOST_PORT=6379

# --- Storage -------------------------------------------------------------
# local | vercel_blob
STORAGE_BACKEND=local

# Used only when STORAGE_BACKEND=local.
STORAGE_DIR=./storage

# Used only when STORAGE_BACKEND=vercel_blob.
# On Vercel, prefer OIDC by connecting a private Blob store and setting BLOB_STORE_ID.
# For non-Vercel environments, a read/write token can be used instead.
# BLOB_STORE_ID=store_xxxxxxxxx
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxx

# --- Web / legacy Docker -------------------------------------------------
HTTP_PORT=8080
BACKEND_HOST_PORT=5000
