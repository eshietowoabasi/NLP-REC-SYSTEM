# Copy to .env and fill in real values. Never commit .env.
# Every variable used by docker compose and the backend is listed here.

# --- Application ---------------------------------------------------------
# development | testing | production
APP_ENV=development
# Long random string. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string
LOG_LEVEL=INFO
# Set to true on machines where antivirus software inspects HTTPS (e.g. Avast Web Shield)
# and model downloads fail with CERTIFICATE_VERIFY_FAILED when running natively.
USE_SYSTEM_CERTS=false

# --- First admin account (used once by `flask seed`) --------------------
# The seed command creates this admin only if no admin exists yet. Password: 8+ characters.
# After the first login, change the password from the Profile page.
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-admin-password
ADMIN_FULL_NAME=System Administrator

# --- PostgreSQL ----------------------------------------------------------
POSTGRES_USER=nlprs
POSTGRES_PASSWORD=change-me
POSTGRES_DB=nlprs
# Host port Postgres is published on (change if 5432 is already in use).
POSTGRES_HOST_PORT=5432
# Used only when running the backend outside Docker; compose builds its own URL.
DATABASE_URL=postgresql+psycopg://nlprs:change-me@localhost:5432/nlprs

# --- Redis ---------------------------------------------------------------
REDIS_HOST_PORT=6379
# Used only when running the backend outside Docker.
REDIS_URL=redis://localhost:6379/0

# --- Storage -------------------------------------------------------------
# Where uploaded documents and generated reports are written (a Docker volume in compose).
STORAGE_DIR=./storage

# --- Web -----------------------------------------------------------------
# Host port for Nginx (the single entry point in development).
HTTP_PORT=8080
# Host port the Flask backend is published on, for running the frontend outside Docker.
BACKEND_HOST_PORT=5000
