# Copy to backend/.env for local development. Never commit real secrets.
FLASK_APP=wsgi.py
FLASK_ENV=development
APP_CONFIG=development
SECRET_KEY=change-me
DATABASE_URL=postgresql+psycopg2://nlprs:nlprs@localhost:5432/nlprs
UPLOAD_FOLDER=../data/raw
REDIS_URL=redis://localhost:6379/0
# sbert (default) or hashing (offline development only; results are not semantic)
EMBEDDING_BACKEND=sbert
SBERT_MODEL=sentence-transformers/all-MiniLM-L6-v2
