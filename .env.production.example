# Production settings for docker-compose.prod.yml. Copy to .env and fill in.
# Never commit the real .env.

# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

POSTGRES_DB=nlprs
POSTGRES_USER=nlprs
POSTGRES_PASSWORD=

# Folder on the host containing fullchain.pem and privkey.pem for HTTPS.
TLS_CERT_DIR=/etc/nlprs/certs

INSTITUTION_NAME=Department of Computer Science, Faculty of Computing, University of Uyo
